{
  "$comment": "The DESNRE 3D model, format_version 1 (desnre-publish-design.md §4). The extension and the API both validate against this file. Only the keywords type, required, properties, const, pattern, minItems, maxItems and items are used, so a small validator reads it on both sides.",
  "type": "object",
  "required": ["format", "format_version", "name", "data", "source", "counts", "zones", "nodes", "edges"],
  "properties": {
    "format": {"const": "desnre-model"},
    "format_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
    "data": {"const": "synthetic"},
    "source": {
      "type": "object",
      "required": ["workspace", "sdem", "metamodel"],
      "properties": {"workspace": {"type": "string"}, "sdem": {"type": "string"}, "metamodel": {"type": "string"}}
    },
    "counts": {
      "type": "object",
      "required": ["records", "inner", "mappings"],
      "properties": {"records": {"type": "integer"}, "inner": {"type": "integer"}, "mappings": {"type": "integer"}}
    },
    "environment": {"type": "string"},
    "scale": {"type": "number"},
    "zone_links": {"type": "array", "maxItems": 5000},
    "zones": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array"}},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"type": "array", "minItems": 7, "maxItems": 8}},
    "edges": {"type": "array", "maxItems": 10000, "items": {"type": "array", "minItems": 4, "maxItems": 5}}
  }
}

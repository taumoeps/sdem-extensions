{
  "name": "desnre",
  "command": "sdem-desnre",
  "version": "0.10.1",
  "description": "Publishes a made-up SDEM workspace to your own page of the DESNRE site, as a 3D view — a draft first, then live",
  "kind": [
    "publisher"
  ],
  "sdem": ">=0.18,<0.21",
  "metamodel": ">=0.14,<0.19",
  "uses": [
    "--version",
    "check --json",
    "layout --layer A1|A2|A3|A4 --json",
    "zones --layout --json",
    "document --layer A1…A4",
    "types A1…A4 --json",
    "change propose --json",
    "profile show --json",
    "profile check --json",
    "profile adopt --json"
  ],
  "reads": [
    "a1-business.json",
    "a2-service-domain.json",
    "a3-application.json",
    "a4-technology.json",
    "mappings.json",
    "requirements.json",
    "sdem-profile.json",
    "extensions/desnre.json"
  ],
  "writes": "nothing in the workspace, except extensions/desnre.json when a person confirms a workspace is made-up data, and what they accepted on the workbench (sdem desnre pull): change sets, through sdem change propose, and the profile, through sdem profile check and sdem profile adopt",
  "sends_to": [
    "https://desnre.vercel.app/api/u/<you>/<name>",
    "https://desnre.vercel.app/api/me"
  ],
  "data": "synthetic only",
  "owner": "the sdem-extensions maintainers",
  "licence": "Apache-2.0",
  "contract": "SDEM extension contract EXT-01…EXT-15 (taumoeps/bian-sdem-framework: docs/design/sdem-extensions-spec.md)",
  "home": "https://github.com/taumoeps/sdem-extensions/tree/main/publishers/desnre"
}
